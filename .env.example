# ──────────────────────────────────────
# DATABASE
# ──────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ──────────────────────────────────────
# NEXTAUTH
# ──────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────
# STRIPE
# ──────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ──────────────────────────────────────
# GOOGLE CALENDAR
# ──────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALENDAR_ID="your-calendar-id@gmail.com"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"

# ──────────────────────────────────────
# EMAIL (Resend)
# ──────────────────────────────────────
RESEND_API_KEY="re_..."

# ──────────────────────────────────────
# ADMIN
# ──────────────────────────────────────
ADMIN_EMAIL="admin@theheels.com"

# Secreto de los cron jobs de Vercel (/api/cron/reminders y /api/blog/generate).
# Vercel lo envia solo como "Authorization: Bearer <valor>" en los crons de vercel.json.
# Sin esta variable ambos endpoints devuelven 401.
CRON_SECRET=

# ──────────────────────────────────────
# OPENAI
# ──────────────────────────────────────
# La usan el generador de posts del blog y el chatbot del panel de alumnas.
OPENAI_API_KEY="sk-..."
# Modelo del chatbot. Si no se define, se usa gpt-4o-mini.
OPENAI_CHAT_MODEL="gpt-4o-mini"

# ──────────────────────────────────────
# MASTERCLASS
# ──────────────────────────────────────
# URL embebible del replay de la masterclass (Bunny Stream, Vimeo o un vídeo
# oculto de YouTube). Se sirve solo desde /api/masterclass/replay, nunca en el
# HTML de la pagina. Sin esta variable el replay muestra "se esta subiendo"
# en lugar de un reproductor roto.
MASTERCLASS_REPLAY_URL=""

# Enlace de compra de la oferta de la ventana de 72 horas (Fundamentos a 39 EUR).
# Mientras el checkout multiproducto no este desplegado, aqui va un Payment Link
# de Stripe. Sin esta variable el bloque de oferta no se muestra.
MASTERCLASS_OFERTA_URL=""
